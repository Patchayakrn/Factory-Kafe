  <Code>
Public Function ThaiBahtText(ByVal value As Object) As String
    If value Is Nothing OrElse IsDBNull(value) Then Return "ศูนย์บาทถ้วน"
    Dim amount As Decimal = Math.Abs(Math.Round(Convert.ToDecimal(value), 2))
    Dim baht As Long = CLng(Math.Truncate(amount))
    Dim satang As Integer = CInt(Math.Round((amount - baht) * 100D))
    Dim result As String = If(Convert.ToDecimal(value) &lt; 0D, "ลบ", "") &amp; ReadThaiNumber(baht) &amp; "บาท"
    If satang = 0 Then Return result &amp; "ถ้วน"
    Return result &amp; ReadThaiNumber(satang) &amp; "สตางค์"
End Function

Private Function ReadThaiNumber(ByVal number As Long) As String
    If number = 0 Then Return "ศูนย์"
    If number &gt;= 1000000 Then
        Return ReadThaiNumber(number \ 1000000) &amp; "ล้าน" &amp; If(number Mod 1000000 = 0, "", ReadThaiNumber(number Mod 1000000))
    End If
    Dim d() As String = {"ศูนย์", "หนึ่ง", "สอง", "สาม", "สี่", "ห้า", "หก", "เจ็ด", "แปด", "เก้า"}
    Dim result As String = ""
    If number &gt;= 100000 Then result &amp;= d(number \ 100000) &amp; "แสน" : number = number Mod 100000
    If number &gt;= 10000 Then result &amp;= d(number \ 10000) &amp; "หมื่น" : number = number Mod 10000
    If number &gt;= 1000 Then result &amp;= d(number \ 1000) &amp; "พัน" : number = number Mod 1000
    If number &gt;= 100 Then result &amp;= d(number \ 100) &amp; "ร้อย" : number = number Mod 100
    If number &gt;= 10 Then
        Dim tens As Long = number \ 10
        If tens = 1 Then
            result &amp;= "สิบ"
        ElseIf tens = 2 Then
            result &amp;= "ยี่สิบ"
        Else
            result &amp;= d(tens) &amp; "สิบ"
        End If
        number = number Mod 10
    End If
    If number &gt; 0 Then result &amp;= If(number = 1 AndAlso result &lt;&gt; "", "เอ็ด", d(number))
    Return result
End Function
  </Code>
