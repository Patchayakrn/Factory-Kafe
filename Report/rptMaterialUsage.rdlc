<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="dsMaterialUsageSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local DataSet */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>f8a604a2-7a95-4ad4-95ef-9b60d9c8f041</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsMaterialUsage">
      <Query>
        <DataSourceName>dsMaterialUsageSource</DataSourceName>
        <CommandText>/* Local DataTable */</CommandText>
      </Query>
      <Fields>
        <Field Name="MaterialID"><DataField>MaterialID</DataField></Field>
        <Field Name="MaterialDetail"><DataField>MaterialDetail</DataField></Field>
        <Field Name="UnitUse"><DataField>UnitUse</DataField></Field>
        <Field Name="BalancePrevious"><DataField>BalancePrevious</DataField></Field>
        <Field Name="RestQty"><DataField>RestQty</DataField></Field>
        <Field Name="RealUse"><DataField>RealUse</DataField></Field>
        <Field Name="UseFromBOM"><DataField>UseFromBOM</DataField></Field>
